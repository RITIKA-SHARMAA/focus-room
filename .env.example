# Google AI Studio key for the "Break it down" feature (https://aistudio.google.com/apikey).
# Put your real key in .env.local (never in this file: this one is committed to GitHub).
# Without a key the app still works; the AI helper shows a friendly "not set up" message.
GEMINI_API_KEY=

# Optional: override the main model. Defaults to gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional: models to try, in order, when the main one is overloaded ("high demand").
# Defaults to gemini-flash-latest,gemini-2.5-flash. Set it empty to turn fallbacks off.
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash
